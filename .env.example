# Paste these into RunPod > Template > Environment variables.
# Use the key icon (Secret) for HF_TOKEN — plain env vars are stored and
# displayed in plaintext.

# --- required -------------------------------------------------------------
# HF token from an account that has accepted the FLUX.1-dev licence:
# https://huggingface.co/black-forest-labs/FLUX.1-dev
# Without it, flux1-dev.safetensors and ae.safetensors 401. The boot doesn't
# abort — you just get a loud warning and no base model.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# --- LoRAs ----------------------------------------------------------------
# Nothing is baked into the image or the workflows: LoRAs are entirely
# yours to configure here. Adding a line here and restarting the pod
# downloads exactly that one file and nothing else.
#
# One entry per line (RunPod's raw editor takes multi-line values), or
# separated by ";", or by a comma directly before the next URL.
# Two accepted forms:
#
#     https://huggingface.co/org/repo/resolve/main/file.safetensors
#     nicename.safetensors=https://huggingface.co/org/repo/resolve/main/file.safetensors
#
# The name on the left is what appears in the ComfyUI dropdown. Whatever
# name you use, select it in the LoRA node once the pod is up — the bundled
# workflows ship with placeholder slots, not a hardcoded LoRA.
#
# A ?download=true suffix is fine: the filename comes from the URL path, and
# the name=url split takes the FIRST "=" only, so query strings survive.
# The Authorization header is sent to huggingface.co only, never to a
# third-party host.
LORAS=

# Example (yours will differ):
# LORAS=my_lora.safetensors=https://huggingface.co/your-user/your-repo/resolve/main/my_lora.safetensors?download=true

# --- optional -------------------------------------------------------------
# Anything that is not a LoRA: "folder|filename|url", one per line.
# folder is a ComfyUI models/ subdir: controlnet, upscale_models, clip_vision,
# embeddings, style_models, diffusion_models, clip, vae.
# EXTRA_MODELS=upscale_models|4x-UltraSharp.pth|https://huggingface.co/lokCX/4x-Ultrasharp/resolve/main/4x-UltraSharp.pth

# The FLUX base stack (flux1-dev, ae, clip_l, t5xxl_fp16). Set false once
# it's on the volume to save four HEAD requests per boot.
DOWNLOAD_BASE_MODELS=true

# Delete LoRAs that are on the volume but no longer listed in LORAS.
# Only touches files this script downloaded (i.e. present in the manifest).
PRUNE_LORAS=false

# Skip the download step entirely. Fastest restart, assumes a populated volume.
SKIP_PROVISION=false

# Ignore local files and re-fetch everything. Expensive — for a corrupt volume.
FORCE_REDOWNLOAD=false

# Trust existing files without checking their size against the remote.
SKIP_SIZE_CHECK=false

# Extra ComfyUI CLI args, e.g. --preview-method auto --fast
COMFY_ARGS=

# pip packages installed at boot, for trying a node without rebuilding.
# PIP_INSTALL=

# Where models live. Must be inside the network volume mount.
MODELS_DIR=/workspace/models

# Only for the no-Docker bootstrap.sh path — the repo it pulls scripts from.
# REPO_URL=https://github.com/you/flux-comfyui-runpod
